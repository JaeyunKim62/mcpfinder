{
  "name": "mcp-list",
  "version": "0.1.0",
  "description": "MCP Server Directory - Data Collection & Website",
  "type": "module",
  "scripts": {
    "predev": "npm run build:data",
    "dev": "vite",
    "build": "npm run build:data && vite build",
    "build:data": "tsx scripts/build-catalog.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts mcp/*.test.ts",
    "mcp": "tsx mcp/stdio.ts",
    "build:i18n": "tsx scripts/build-translations.ts",
    "sync": "tsx scripts/sync.ts",
    "sync:awesome": "tsx scripts/sources/awesome-list.ts",
    "sync:registry": "tsx scripts/sources/registry.ts",
    "sync:npm": "tsx scripts/sources/npm-registry.ts",
    "sync:github": "tsx scripts/sources/github.ts",
    "merge": "tsx scripts/merge.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^27.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  }
}
